# HarborLens environment variables
# Copy to repo-root .env (gitignored). Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harborlens

# Production integration only (not used by the prototype)
# PORT_DATA_API_URL=https://example.internal/port-data
# PORT_DATA_API_TOKEN=replace-with-secret
